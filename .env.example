# ── Database ──────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://drift:drift@localhost:5432/driftscope

# ── LLM Provider ──────────────────────────────────────────────────────
# Get your free key from https://aistudio.google.com
GEMINI_API_KEY=AIza...
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_RETRY_MAX_OUTPUT_TOKENS=8192
GEMINI_REQUEST_TIMEOUT_SECONDS=60
JUDGE_COSINE_THRESHOLD=0.65

# Ollama (local fallback provider — no API key needed, run `ollama serve` first)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# ── App Settings ──────────────────────────────────────────────────────
APP_ENV=development     # development | production
LOG_LEVEL=INFO

# ── API Auth ─────────────────────────────────────────────────────────
# Leave empty to disable auth (default). Set a random secret to require
# it via the X-API-Key header on /cases, /drift, and /reports.
# /health and /metrics are always open (liveness probes, Prometheus).
API_KEY=

# ── Email Alerts (Phase 4) ────────────────────────────────────────────
ALERT_EMAIL=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
