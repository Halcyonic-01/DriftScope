# ── Database ──────────────────────────────────────────────────────────
# Connection string used by host-side tooling (alembic, scripts/seed.py,
# scripts/run_monitor.py). Format: postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql://drift:drift@localhost:5432/driftscope

# Optional: point the docker compose API (and therefore Grafana) at a
# hosted database instead of the bundled `db` service. Set this to the
# same URL your scheduled eval workflow writes to, so the dashboard
# shows that data. Leave unset for a fully local stack.
# DRIFTSCOPE_DB_URL=postgresql://user:pass@your-host.neon.tech/neondb?sslmode=require

# ── LLM Provider ──────────────────────────────────────────────────────
# Get your free key from https://aistudio.google.com
GEMINI_API_KEY=AIza...
# Google retires model IDs for new API keys. If calls start failing with
# "no longer available to new users", set this to a current model.
# Pin a concrete version rather than a "-latest" alias: DriftScope detects
# provider-side model changes, so a deliberately-moving alias would
# manufacture drift and make the canary meaningless.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_RETRY_MAX_OUTPUT_TOKENS=8192
GEMINI_REQUEST_TIMEOUT_SECONDS=60
JUDGE_COSINE_THRESHOLD=0.65

# Ollama (local fallback provider — no API key needed, run `ollama serve` first)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# ── App Settings ──────────────────────────────────────────────────────
APP_ENV=development     # development | production
LOG_LEVEL=INFO

# ── API Auth ─────────────────────────────────────────────────────────
# Leave empty to disable auth (default). Set a random secret to require
# it via the X-API-Key header on /cases, /drift, and /reports.
# /health and /metrics are always open (liveness probes, Prometheus).
API_KEY=

# ── Email Alerts (Phase 4) ────────────────────────────────────────────
ALERT_EMAIL=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
